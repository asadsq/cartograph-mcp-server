# .gitignore
# ----------
# Purpose (plain English): Lists files Git should never track — build output, editor
# settings, and OS clutter — so the repository only ever contains real source code.

# Maven build output
target/

# Compiled class files
*.class

# Log files
*.log

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*
replay_pid*

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# macOS
.DS_Store

# Editors / IDEs
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
