<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml
  =======
  Purpose (plain English): The build recipe for Cartograph. It says we target Java 21,
  pulls in the MCP SDK (how we talk to AI agents), tree-sitter (how we read source code),
  JGraphT (how we store and search the dependency graph) and JUnit (tests), then packages
  everything into one runnable file: target/cartograph.jar.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.cartograph</groupId>
  <artifactId>cartograph</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Cartograph</name>
  <description>A mapmaker for your codebase — a codebase architecture-graph MCP server.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <mcp.sdk.version>2.0.0</mcp.sdk.version>
    <jgrapht.version>1.5.2</jgrapht.version>
    <treesitter.version>0.25.3</treesitter.version>
    <treesitter.java.version>0.23.4</treesitter.java.version>
    <junit.version>5.14.4</junit.version>

    <compiler.plugin.version>3.15.0</compiler.plugin.version>
    <surefire.plugin.version>3.5.6</surefire.plugin.version>
    <shade.plugin.version>3.6.2</shade.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      The official MCP Java SDK. This single artifact transitively brings in
      mcp-core (protocol + stdio transport) and mcp-json-jackson3 (JSON mapping),
      so we don't need to declare those separately.
    -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>${mcp.sdk.version}</version>
    </dependency>

    <!--
      Graph structure and algorithms (search, reachability, cycles, shortest path).
      We model the codebase as a directed graph and let JGraphT do the graph theory.
    -->
    <dependency>
      <groupId>org.jgrapht</groupId>
      <artifactId>jgrapht-core</artifactId>
      <version>${jgrapht.version}</version>
    </dependency>

    <!--
      tree-sitter: the parsing engine. It reads source code into a syntax tree without
      needing to compile it, and has grammars for many languages — which is how Cartograph
      stays language-agnostic. Each artifact ships prebuilt native libraries for macOS,
      Linux and Windows, so there is nothing to compile on the user's machine.
    -->
    <dependency>
      <groupId>io.github.bonede</groupId>
      <artifactId>tree-sitter</artifactId>
      <version>${treesitter.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.bonede</groupId>
      <artifactId>tree-sitter-java</artifactId>
      <version>${treesitter.java.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>cartograph</finalName>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler.plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.plugin.version}</version>
      </plugin>

      <!--
        Bundles our code and every dependency into one runnable jar, so the whole
        server starts with `java -jar target/cartograph.jar` and nothing else.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade.plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.cartograph.Main</mainClass>
                </transformer>
                <!--
                  The MCP SDK discovers its JSON mapper through META-INF/services.
                  Without merging those files the shaded jar starts and then fails
                  at runtime with "no McpJsonMapper found". This transformer is load-bearing.
                -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
